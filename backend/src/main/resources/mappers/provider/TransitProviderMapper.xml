<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.realtimetransit.backend.provider.repository.TransitProviderMapper">
    <resultMap id="transitProviderRowMap" type="TransitProviderEntity">
        
            <id property="id" column="id" />
            <result property="code" column="code" />
            <result property="displayName" column="display_name" />
            <result property="transportType" column="transport_type" />
            <result property="active" column="active" />
            <result property="createdAt" column="created_at" />
            <result property="updatedAt" column="updated_at" />
        
    </resultMap>

    <sql id="transitProviderColumns">
        id, code, display_name, transport_type, active, created_at, updated_at
    </sql>

    <select id="findAll" resultMap="transitProviderRowMap">
        SELECT <include refid="transitProviderColumns" />
        FROM transit_provider
        ORDER BY id
    </select>

    <select id="findByCode" resultMap="transitProviderRowMap">
        SELECT <include refid="transitProviderColumns" />
        FROM transit_provider
        WHERE code = #{code}
    </select>

    <select id="findAllActive"
            resultMap="transitProviderRowMap">
        SELECT <include refid="transitProviderColumns" />
        FROM transit_provider
        WHERE active = TRUE
        ORDER BY id ASC
    </select>
</mapper>

